# Copy this file to .env.local and fill in your own values.
# These are PLACEHOLDERS - never commit real credentials.

# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase *public* key: the "anon" key or the "publishable" key.
# It is designed to be shipped to browsers; Row Level Security protects the data.
# NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY

# OPTIONAL - voice chat (see README, "Voice chat"). Leave empty to hide the voice button.
# Your LiveKit project WebSocket URL, e.g. wss://your-project.livekit.cloud
VITE_LIVEKIT_URL=
